cabal-version: 2.2

name:           LTeXConfigManipulator
version:        0.1.0.0
description:    Please see the README on GitHub at <https://github.com/t-sasaki915/LTeXConfigManipulator#readme>
homepage:       https://github.com/t-sasaki915/LTeXConfigManipulator#readme
bug-reports:    https://github.com/t-sasaki915/LTeXConfigManipulator/issues
author:         Toma Sasaki
maintainer:     netst915@gmail.com
copyright:      2026 Toma Sasaki
license:        MIT
license-file:   LICENSE
build-type:     Simple
extra-source-files:
    README.md

source-repository head
  type: git
  location: https://github.com/t-sasaki915/LTeXConfigManipulator

executable LTeXConfigManipulator
  main-is: Main.hs
  other-modules:
      Paths_LTeXConfigManipulator
      Types
  autogen-modules:
      Paths_LTeXConfigManipulator
  hs-source-dirs:
      app
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      base >=4.7 && <5
    , aeson >=2.2 && <2.3
    , text >=2.1 && <2.2
    , optparse-applicative >=0.18 && <0.19
    , directory >=1.3 && <1.4
    , filepath >=1.5 && <1.6
    , bytestring >=0.12 && <0.13
    , vector >=0.13 && <0.14
    , containers >=0.7 && <0.8
    , lens >=5 && <6
  default-language: Haskell2010
  default-extensions: OverloadedStrings, LambdaCase

